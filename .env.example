# JBrain configuration — copy to .env (install.sh generates this for you).

# The public domain that points (A record) at this VM. Caddy issues HTTPS for it.
JBRAIN_DOMAIN=brain.example.com

# Email used by Caddy/Let's Encrypt for cert notices.
ACME_EMAIL=you@example.com

# LLM provider for the "Knowledge Architect" and AI workflow actions.
# (The legacy ANTHROPIC_API_KEY / ANTHROPIC_MODEL names still work as aliases.)
LLM_PROVIDER=anthropic
LLM_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
LLM_MODEL=claude-sonnet-4-6

# Optional: xAI Grok. Set this and you can pick a grok-* model in System → Model
# (the provider is inferred from the chosen model id, so Claude + Grok coexist).
# XAI_API_KEY=xai-xxxxxxxxxxxxxxxx

# Display name of your brain.
BRAIN_NAME=My Brain

# The pasteable access key (the "cert") — the only credential. install.sh
# generates one. If left empty, the server generates a key on first run and
# prints it (and writes /data/access-key.txt). Editing this value rotates the
# key on next restart.
JBRAIN_ACCESS_KEY=

# Local embedding model (runs in-container, no extra API key).
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Local speech-to-text for audio attachments (faster-whisper, in-container, no API key).
# Size trades accuracy for RAM/speed: tiny | base | small | medium | large-v3. "base" is a
# good CPU default; use "tiny" on a tight (2 GB) box. The model downloads on first use.
AUDIO_MODEL=base
AUDIO_COMPUTE_TYPE=int8

# Video frame sampling for the vision summary: a PERCENT step ("25%" → frames at
# 0/25/50/75/100% of the clip) OR a TIME interval ("30s" → a frame every 30 seconds).
# VIDEO_FRAME_MAX caps the count (frames re-space evenly if the step would exceed it).
VIDEO_FRAME_INTERVAL=25%
VIDEO_FRAME_MAX=8

# Path to the SQLite database inside the container (on a named volume).
DB_PATH=/data/brain.db

# Timezone (IANA name). Drives midnight jobs, the notes/daily/YYYY/MM/DD bucket,
# the time the assisted/research agent reasons in, and how the UI labels stored
# (UTC) timestamps. Set to your local zone, e.g. America/New_York. Defaults to UTC.
TZ=UTC

# Web Push contact (a mailto: or https: URL) sent to push services on each send.
# The VAPID keypair itself auto-generates on first boot (stored in the DB); set
# VAPID_PRIVATE_KEY/VAPID_PUBLIC_KEY only to pin a keypair across machines.
# NOTE: the VM must allow OUTBOUND 443 to Apple/Google/Mozilla push services.
VAPID_SUBJECT=mailto:you@example.com

# CORS origins allowed to call the API (comma-separated). Needed only when the
# PWA is hosted separately (e.g. GitHub Pages) on a different origin. "*" is safe
# because auth is a bearer token (no cookies); tighten to your Pages URL if you like.
JBRAIN_CORS_ORIGINS=*

# Stable compose project name so the auto-updater targets the same stack.
COMPOSE_PROJECT_NAME=jbrain

# Set to "autoupdate" to run the updater sidecar (applies PWA-requested updates
# automatically). It mounts the Docker socket + project dir — leave empty to
# keep updates manual (./update.sh).
COMPOSE_PROFILES=
