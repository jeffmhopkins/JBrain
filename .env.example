# JBrain configuration — copy to .env (install.sh generates this for you).

# The public domain that points (A record) at this VM. Caddy issues HTTPS for it.
JBRAIN_DOMAIN=brain.example.com

# Email used by Caddy/Let's Encrypt for cert notices.
ACME_EMAIL=you@example.com

# LLM provider for the "Knowledge Architect" and AI workflow actions.
# (The legacy ANTHROPIC_API_KEY / ANTHROPIC_MODEL names still work as aliases.)
LLM_PROVIDER=anthropic
LLM_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
LLM_MODEL=claude-sonnet-4-6

# Optional: xAI Grok. Set this and you can pick a grok-* model in System → Model
# (the provider is inferred from the chosen model id, so Claude + Grok coexist).
# XAI_API_KEY=xai-xxxxxxxxxxxxxxxx

# Optional: LOCAL LLM (Ollama, OpenAI-compatible, no API key). When enabled, a task
# tier whose model id is local (an Ollama 'name:tag', e.g. set models.cheap to
# "qwen2.5:7b" in prompts.yaml) routes to the local server while cloud tiers stay on
# the API — the hybrid a CPU box wants (offload the cheap tier; keep the agent cloud).
# A local-tier failure falls back to the cloud default (LLM_LOCAL_FALLBACK), so a
# local outage degrades rather than breaks.
#   Mode A (turnkey): set COMPOSE_PROFILES=localllm below — JBrain runs Ollama in a
#                     container and pulls LLM_LOCAL_MODEL on first boot. Use the
#                     compose defaults (http://ollama:11434...).
#   Mode B (BYO):     install Ollama on the host (curl -fsSL https://ollama.com/install.sh | sh)
#                     and set the URLs to http://host.docker.internal:11434(/v1).
# CPU/RAM guidance (32GB DDR4 box): use a 7-8B q4 model; allow up to ~13B; never 70B.
# LLM_LOCAL_ENABLE=true
# LLM_LOCAL_BASE_URL=http://ollama:11434/v1
# LLM_LOCAL_ADMIN_URL=http://ollama:11434
# LLM_LOCAL_MODEL=qwen2.5:7b
# LLM_LOCAL_FALLBACK=true
# Raise the per-request timeout for slow CPU inference (seconds).
# LLM_TIMEOUT_SECONDS=600
# RSS cap for the Ollama container (Mode A). 8g fits a 7-8B q4 with headroom.
# OLLAMA_MEM_LIMIT=8g

# Display name of your brain.
BRAIN_NAME=My Brain

# The pasteable access key (the "cert") — the only credential. install.sh
# generates one. If left empty, the server generates a key on first run and
# prints it (and writes /data/access-key.txt). Editing this value rotates the
# key on next restart.
JBRAIN_ACCESS_KEY=

# Local embedding model (runs in-container, no extra API key).
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Local speech-to-text for audio attachments (faster-whisper, in-container, no API key).
# Size trades accuracy for RAM/speed: tiny | base | small | medium | large-v3. "base" is a
# good CPU default; use "tiny" on a tight (2 GB) box. The model downloads on first use.
AUDIO_MODEL=base
AUDIO_COMPUTE_TYPE=int8

# Video → vision-summary frame sampling. Set BOTH together:
#   VIDEO_FRAME_INTERVAL — cadence: a time interval ("30s" → every 30s) or a percent step
#                          ("25%" → at 0/25/50/75/100% of the clip).
#   VIDEO_FRAME_MAX      — hard cap on frames = your cost ceiling (all frames go in ONE vision
#                          call). If the cadence would exceed it, frames re-space evenly.
#                          Set to 0 to turn frame vision OFF (transcript only, no vision call).
VIDEO_FRAME_INTERVAL=30s
VIDEO_FRAME_MAX=8

# Path to the SQLite database inside the container (on a named volume).
DB_PATH=/data/brain.db

# Timezone (IANA name). Drives midnight jobs, the notes/daily/YYYY/MM/DD bucket,
# the time the assisted/research agent reasons in, and how the UI labels stored
# (UTC) timestamps. Set to your local zone, e.g. America/New_York. Defaults to UTC.
TZ=UTC

# Web Push contact (a mailto: or https: URL) sent to push services on each send.
# The VAPID keypair itself auto-generates on first boot (stored in the DB); set
# VAPID_PRIVATE_KEY/VAPID_PUBLIC_KEY only to pin a keypair across machines.
# NOTE: the VM must allow OUTBOUND 443 to Apple/Google/Mozilla push services.
VAPID_SUBJECT=mailto:you@example.com

# CORS origins allowed to call the API (comma-separated). Needed only when the
# PWA is hosted separately (e.g. GitHub Pages) on a different origin. "*" is safe
# because auth is a bearer token (no cookies); tighten to your Pages URL if you like.
JBRAIN_CORS_ORIGINS=*

# Stable compose project name so the auto-updater targets the same stack.
COMPOSE_PROJECT_NAME=jbrain

# Compose profiles (comma-separated). "autoupdate" runs the updater sidecar
# (applies PWA-requested updates automatically; mounts the Docker socket + project
# dir). "localllm" runs the Ollama services (see the LOCAL LLM block above). Leave
# empty for manual updates (./update.sh) and cloud-only LLM.
#   e.g. COMPOSE_PROFILES=autoupdate,localllm
COMPOSE_PROFILES=
