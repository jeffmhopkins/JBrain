# JBrain configuration — copy to .env (install.sh generates this for you).

# The public domain that points (A record) at this VM. Caddy issues HTTPS for it.
JBRAIN_DOMAIN=brain.example.com

# Email used by Caddy/Let's Encrypt for cert notices.
ACME_EMAIL=you@example.com

# Anthropic Claude API key (the "Knowledge Architect").
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# Claude model for the architect.
ANTHROPIC_MODEL=claude-sonnet-4-6

# Display name of your brain.
BRAIN_NAME=My Brain

# The pasteable access key (the "cert") — the only credential. install.sh
# generates one. If left empty, the server generates a key on first run and
# prints it (and writes /data/access-key.txt). Editing this value rotates the
# key on next restart.
JBRAIN_ACCESS_KEY=

# Local embedding model (runs in-container, no extra API key).
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Path to the SQLite database inside the container (on a named volume).
DB_PATH=/data/brain.db

# Timezone.
TZ=UTC

# Stable compose project name so the auto-updater targets the same stack.
COMPOSE_PROJECT_NAME=jbrain

# Set to "autoupdate" to run the updater sidecar (applies PWA-requested updates
# automatically). It mounts the Docker socket + project dir — leave empty to
# keep updates manual (./update.sh).
COMPOSE_PROFILES=
