# Rendered to ./Caddyfile by install.sh ({{DOMAIN}} / {{ACME_EMAIL}} injected).
# Caddy automatically obtains and renews a Let's Encrypt certificate for the
# domain, then reverse-proxies everything to the API container.
{
	email {{ACME_EMAIL}}
}

{{DOMAIN}} {
	encode zstd gzip

	# Security headers (Caddy adds HSTS automatically on auto-HTTPS). The CSP is
	# strict but allows the inline styles the app uses; tighten if you customise.
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Frame-Options "DENY"
		Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' https:; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
		-Server
	}

	# Live deploy console: the captured update.sh / updater output, served by Caddy
	# itself (which stays up while the API restarts) so the PWA can stream a
	# restarting or FAILED deploy. Gated by the access key (bcrypt) so the logs
	# aren't public. {{LOG_AUTH_HASH}} is injected by update.sh from .env.
	handle_path /deploy-status/* {
		basic_auth {
			jbrain {{LOG_AUTH_HASH}}
		}
		root * /srv/deploy-status
		file_server
	}

	# Stream Server-Sent Events (chat) without buffering.
	@sse path /api/chat/*
	reverse_proxy @sse api:8000 {
		flush_interval -1
	}

	reverse_proxy api:8000
}
