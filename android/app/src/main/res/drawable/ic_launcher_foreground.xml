<?xml version="1.0" encoding="utf-8"?>
<!-- Matches the PWA icon (web/public/icon.svg): a 4-node knowledge graph in the
     accent colour. Shapes are converted to <path> (VectorDrawable has no circle/line)
     and scaled into the adaptive-icon safe zone so the launcher mask won't clip it. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="512"
    android:viewportHeight="512">
    <group
        android:pivotX="256"
        android:pivotY="256"
        android:scaleX="0.82"
        android:scaleY="0.82">
        <!-- edges between the nodes -->
        <path
            android:strokeColor="#7f9aa6"
            android:strokeWidth="14"
            android:strokeLineCap="round"
            android:pathData="M176,168 L340,184 M176,168 L200,344 M340,184 L356,336 M200,344 L356,336 M340,184 L200,344" />
        <!-- the four nodes -->
        <path
            android:fillColor="#7f9aa6"
            android:pathData="M150,168 a26,26 0 1,1 52,0 a26,26 0 1,1 -52,0 Z M314,184 a26,26 0 1,1 52,0 a26,26 0 1,1 -52,0 Z M174,344 a26,26 0 1,1 52,0 a26,26 0 1,1 -52,0 Z M330,336 a26,26 0 1,1 52,0 a26,26 0 1,1 -52,0 Z" />
    </group>
</vector>
