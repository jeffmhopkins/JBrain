#!/usr/bin/env bash
# jt — JBrain Test. One command for every domain. Run from anywhere: `./jt [cmd]`.
#
#   ./jt            run the gate (backend non-concurrency tier + frontend)
#   ./jt ci         run EVERY domain, capture logs, print a PASS/FAIL summary
#   ./jt install    install all test deps so `./jt ci` runs (back+front+e2e)
#   ./jt back  [..] backend pytest (extra args passed through, e.g. ./jt back -k notes)
#   ./jt front      frontend vitest run
#   ./jt unit       the `unit` tier across both domains (one word, one meaning)
#   ./jt cov        both domains with coverage + per-domain floors
#   ./jt e2e        system tier: build PWA + Playwright vs a real server (LLM faked)
#   ./jt android    android JVM unit tests (Robolectric; needs the SDK)
#   ./jt report     reprint the last `./jt ci` summary
#   ./jt watch      frontend vitest watch (TDD loop)
#
# Full logs from `./jt ci` live in .jt-logs/<domain>.log.
# First time on a machine: `./jt install` (and `./jt install android` for the SDK).
# The native commands still work too: `cd server && pytest`, `cd web && npm test`.
set -uo pipefail
ROOT="$(cd "$(dirname "$0")" && pwd)"
LOGDIR="$ROOT/.jt-logs"
cmd="${1:-all}"
[ "$#" -gt 0 ] && shift || true

back()  { ( cd "$ROOT/server" && python -m pytest "$@" ); }
front() { ( cd "$ROOT/web"    && npm run --silent "$@" ); }

# Free the e2e server ports BY PORT (never a broad pgrep that could match the test
# runner itself). Falls back to targeted pkill patterns that match only the e2e servers.
free_e2e_ports() {
  if command -v fuser >/dev/null 2>&1; then
    fuser -k 8918/tcp 8919/tcp >/dev/null 2>&1 || true
  else
    pkill -f "fake_llm:app" 2>/dev/null || true
    pkill -f "app.main:app --host 127.0.0.1 --port 8918" 2>/dev/null || true
  fi
  sleep 1
}

# Hardened e2e: build the PWA, free ports, run Playwright with CI=1 so it boots its OWN
# fresh servers and tears them down on exit, then free ports again (belt & suspenders).
run_e2e() {
  ( cd "$ROOT/web" && npm run build ) || return 1
  free_e2e_ports
  ( cd "$ROOT/e2e" && CI=1 npx playwright test "$@" ); local rc=$?
  free_e2e_ports
  return $rc
}

android_available() {
  [ -n "${ANDROID_HOME:-}${ANDROID_SDK_ROOT:-}" ] && return 0
  grep -q '^sdk.dir=' "$ROOT/android/local.properties" 2>/dev/null && return 0
  command -v sdkmanager >/dev/null 2>&1
}

# --- `install`: provision test deps per domain ------------------------------------ #
inst_back() {
  echo "▶ backend (python) test deps…"
  python -m pip install -q -U pip
  # pywebpush -> http-ece often won't build in sandboxes; install everything else first,
  # then pywebpush best-effort (the push module is import-guarded; its tests skip).
  grep -v '^pywebpush' "$ROOT/server/requirements.txt" > /tmp/jt-reqs.txt
  python -m pip install -q -r /tmp/jt-reqs.txt -r "$ROOT/server/requirements-dev.txt" || return 1
  python -m pip install -q -r "$ROOT/server/requirements-vision.txt" 2>/dev/null \
    || echo "  · vision deps skipped (lab-vision tests stub the OCR/PDF engines anyway)"
  python -m pip install -q pywebpush==2.0.0 2>/dev/null \
    || echo "  · pywebpush unavailable — push-encryption tests will skip"
}
inst_front() { echo "▶ frontend (web) deps…"; ( cd "$ROOT/web" && npm ci --no-audit --no-fund ); }
inst_e2e() {
  echo "▶ e2e (playwright) deps + chromium…"
  ( cd "$ROOT/e2e" && npm ci --no-audit --no-fund ) || return 1
  ( cd "$ROOT/e2e" && (npx playwright install --with-deps chromium 2>/dev/null || npx playwright install chromium) )
}
inst_android() {
  echo "▶ android SDK…"
  if android_available; then echo "  · SDK already present"; else
    if [ -x "$ROOT/.claude/hooks/setup-android-sdk.sh" ]; then bash "$ROOT/.claude/hooks/setup-android-sdk.sh";
    else echo "  · install the Android SDK and set ANDROID_HOME (or android/local.properties sdk.dir)"; fi
  fi
  echo "  · JUnit/Robolectric are fetched by Gradle on first ./jt android"
}
install() {
  t="${1:-all}"
  case "$t" in all|back)  inst_back  ;; esac
  case "$t" in all|front) inst_front ;; esac
  case "$t" in all|e2e)   inst_e2e   ;; esac
  case "$t" in android)   inst_android ;; esac
  [ "$t" = all ] && echo "✓ test deps installed (run './jt install android' for the SDK)" || true
}

# --- `ci`: run all domains, log each, summarize ----------------------------------- #
SUMMARY="$LOGDIR/summary.txt"

run_step() {
  name="$1"; reason_fn="$2"; shift 2
  log="$LOGDIR/$name.log"
  printf '  %-9s running…\r' "$name" >&2
  ( "$@" ) >"$log" 2>&1; rc=$?
  reason="$("$reason_fn" "$log")"
  if [ "$rc" -eq 0 ]; then status="PASS"; else status="FAIL"; fi
  printf '%s|%s|%s|%s\n' "$name" "$status" "$reason" "$log" >>"$SUMMARY"
  return "$rc"
}

# Reason extractors — clean, single-line "what happened" for the summary.
reason_back()    { local p c; p=$(grep -hoE "[0-9]+ (passed|failed|error)" "$1" | tail -1)
                   c=$(grep -hoE "Total coverage: [0-9.]+%" "$1" | tail -1)
                   printf '%s%s' "${p:-no result}" "${c:+ · ${c#Total coverage: } cov}"; }
reason_front()   { local p c; p=$(grep -hoE "Tests +[0-9]+ (passed|failed)" "$1" | tail -1 | grep -oE "[0-9]+ (passed|failed)")
                   c=$(grep -hoE "Lines +: [0-9.]+%" "$1" | tail -1 | grep -oE "[0-9.]+%")
                   printf '%s%s' "${p:-no result}" "${c:+ · $c cov}"; }
reason_e2e()     { grep -hoE "[0-9]+ (passed|failed)" "$1" | tail -1 || echo "no result"; }
reason_android() { if grep -q "BUILD SUCCESSFUL" "$1"; then echo "BUILD SUCCESSFUL"
                   else grep -hoE "BUILD FAILED|FAILURE:.*" "$1" | head -1 || echo "BUILD FAILED"; fi; }

print_summary() {
  echo; echo "JBrain test summary"
  local any_fail=0
  while IFS='|' read -r name status reason log; do
    [ "$status" = "FAIL" ] && any_fail=1
    printf '  %-9s %-5s  %-30s %s\n' "$name" "$status" "${reason:-—}" "${log#"$ROOT"/}"
  done < "$SUMMARY"
  echo
  if [ "$any_fail" -eq 0 ]; then echo "✅ all green"; else
    echo "❌ failures above — full output in the listed log(s). Failing tails:"
    while IFS='|' read -r name status reason log; do
      [ "$status" = "FAIL" ] || continue
      echo "----- $name (tail) -----"; tail -25 "$log"
    done < "$SUMMARY"
  fi
}

ci() {
  mkdir -p "$LOGDIR"; : > "$SUMMARY"
  run_step back  reason_back  back --cov=app --cov-report=term-missing
  run_step front reason_front front test:cov
  run_step e2e   reason_e2e   run_e2e
  if android_available; then
    run_step android reason_android sh -c "cd '$ROOT/android' && ./gradlew :app:testDebugUnitTest --no-daemon --console=plain"
  else
    printf 'android|SKIP|no Android SDK — run ./jt install android|-\n' >>"$SUMMARY"
  fi
  print_summary
  grep -q '|FAIL|' "$SUMMARY" && return 1 || return 0
}

case "$cmd" in
  all)     back -m "not concurrency" && front test ;;
  ci)      ci ;;
  install) install "${1:-all}" ;;
  report)  [ -f "$SUMMARY" ] && print_summary || echo "no summary yet — run ./jt ci" ;;
  back)    back "$@" ;;
  front)   front test ;;
  unit)    back -m unit --no-cov && front test ;;
  cov)     back --cov=app --cov-report=term-missing && front test:cov ;;
  e2e)     run_e2e "$@" ;;
  android) ( cd "$ROOT/android" && ./gradlew :app:testDebugUnitTest --no-daemon --console=plain ) ;;
  watch)   front test:watch ;;
  -h|--help|help) sed -n '2,18p' "$0" | sed 's/^# \{0,1\}//' ;;
  *)       echo "jt: unknown command '$cmd'"; echo "usage: ./jt [all|ci|install|back|front|unit|cov|e2e|android|report|watch]"; exit 2 ;;
esac
